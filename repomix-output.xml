.card-reserva h2 {
    text-align: center;
    font-size: 24px;
    font-weight: 400;
    margin-bottom: 25px;
    color: var(--color-texto);
}

/* Campos de texto estilizados individuales (uno abajo del otro) */
.campo-input-unico {
    width: 100%;
    padding: 12px 15px;
    margin-bottom: 15px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background-color: var(--warm-white);
    font-size: 14px;
    outline: none;
}

.campo-input-unico:focus {
    border-color: var(--gold);
}

/* Títulos de las secciones de radio buttons */
.titulo-seccion-turno {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    color: var(--text-mid);
    margin: 20px 0 10px 0;
    text-transform: uppercase;
}

/* Contenedor horizontal para los días */
.dias-horizontales {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
    overflow-x: auto;
}

.dias-horizontales label {
    flex: 1;
    min-width: 60px;
    background: var(--warm-white);
    border: 1px solid var(--border);
    padding: 10px 5px;
    text-align: center;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
}

.dias-horizontales label span {
    display: block;
    font-size: 10px;
    color: var(--text-mid);
    text-transform: uppercase;
}

/* Grilla de 4 columnas para las horas */
.horas-grilla-cuatro {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 30px;
}

.horas-grilla-cuatro label {
    background: var(--warm-white);
    border: 1px solid var(--border);
    padding: 12px 0;
    text-align: center;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
}

/* Ocultar los inputs circulares nativos */
.dias-horizontales input[type="radio"],
.horas-grilla-cuatro input[type="radio"] {
    display: none;
}

/* Cambiar el fondo del label cuando su input interno está seleccionado (Tus marcas marrones) */
.dias-horizontales label:has(input:checked),
.horas-grilla-cuatro label:has(input:checked) {
    background-color: var(--color-primario);
